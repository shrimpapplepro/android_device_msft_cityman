type cityman-sh, domain;
type cityman-sh_exec, exec_type, file_type, vendor_file_type;

# Started by init
init_daemon_domain(cityman-sh)

# Access to /data/misc/radio/*
allow cityman-sh radio_data_file:file create_file_perms;
allow cityman-sh radio_data_file:dir create_dir_perms;

# Chwon /data/misc/radio/modem_config
allow cityman-sh self:capability chown;

# Copy /firmware/image/modem_pr/mcfg/configs/ to /data/misc/radio/*
allow cityman-sh firmware_file:file r_file_perms;
allow cityman-sh firmware_file:dir r_dir_perms;

allow cityman-sh shell_exec:file r_file_perms;

# execute toybox/toolbox
allow cityman-sh toolbox_exec:file rx_file_perms;

# 13: platform labels /data/misc/radio as radio_core_data_file
allow cityman-sh radio_core_data_file:file create_file_perms;
allow cityman-sh radio_core_data_file:dir create_dir_perms;
