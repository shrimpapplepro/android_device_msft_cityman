cc_binary {
    name: "android.hardware.power@1.0-service.cityman",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    init_rc: ["android.hardware.power@1.0-service.cityman.rc"],
    vintf_fragments: ["android.hardware.power@1.0.xml"],
    srcs: [
        "service.cpp",
        "Power.cpp",
        "HintConfig.cpp",
        "Sysfs.cpp",
    ],
    shared_libs: [
        "libhidlbase",
        "libcutils",
        "liblog",
        "libutils",
        "android.hardware.power@1.0",
    ],
    vendor: true,
    overrides: [
        "android.hardware.power@1.0-service",
        "android.hardware.power-service-qti",
        "android.hardware.power-service",
    ],
}
