cc_library_shared {
    name: "libril_wrapper",
    srcs: ["ril_wrapper.c"],
    shared_libs: [
        "liblog",
        "libdl",
    ],
    header_libs: [
        "ril_headers",
        "libhardware_legacy_headers",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
    compile_multilib: "64",
    vendor: true,
}

cc_binary {
    name: "lumia-modem-init",
    srcs: ["lumia_modem_init.c"],
    shared_libs: [
        "liblog",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-function",
    ],
    compile_multilib: "64",
    vendor: true,
}

cc_binary {
    name: "modem-diag",
    srcs: ["modem_diag.c"],
    shared_libs: [
        "liblog",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
    compile_multilib: "64",
    vendor: true,
}

